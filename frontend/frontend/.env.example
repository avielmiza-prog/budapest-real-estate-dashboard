# Copy to `.env.local` for local dev, or set these in your deploy platform's
# (Vercel) project settings. NEXT_PUBLIC_* vars are inlined into the build at
# `next build` time — changing them requires a rebuild/redeploy, not just a
# server restart. See lib/api.ts.

# Base URL of the FastAPI backend. If unset, the fallback depends on the
# build: a production build (`next build`, incl. on Vercel) falls back to
# the deployed Render backend; local dev (`next dev`) falls back to
# http://localhost:8000. Set this explicitly to override either one.
NEXT_PUBLIC_API_URL=http://localhost:8000
