# Copy to `.env.local` for local dev, or set these in your deploy platform's
# (Vercel) project settings. NEXT_PUBLIC_* vars are inlined into the build at
# `next build` time — changing them requires a rebuild/redeploy, not just a
# server restart. See lib/api.ts.

# Base URL of the FastAPI backend. If unset, this now falls back to the
# deployed Render backend UNCONDITIONALLY — including local dev — so keep
# this set to localhost when working locally, or `next dev` will talk to
# (and can mutate data on) the live production backend instead.
NEXT_PUBLIC_API_URL=http://localhost:8000
