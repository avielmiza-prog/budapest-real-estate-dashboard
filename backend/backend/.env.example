# Copy this file to `.env` and fill in what you need — every variable below
# has a working default for local development, so an empty/missing .env is
# fine too. See app/database.py, app/main.py, and app/access_control.py.

# --- Database -----------------------------------------------------------
# Local dev default: SQLite file at backend/budapest_apartments.db.
# For production (Render/Railway/Supabase Postgres), paste the connection
# string they give you — a `postgres://` scheme is auto-corrected to
# `postgresql://` if that's what you got.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- CORS -----------------------------------------------------------------
# Comma-separated list of exact frontend origins allowed to call this API.
# Defaults (baked into app/main.py) already cover this project's deployment
# — the Vercel production domain + localhost — so this line is only needed
# if you deploy the frontend somewhere else.
# FRONTEND_ORIGINS=https://budapest-real-estate-dashboard.vercel.app,http://localhost:3000

# Regex for origins that vary per-deploy (Vercel preview URLs get a unique
# subdomain per branch/PR). Also defaults to matching *.vercel.app already —
# set this to an empty string to opt out, or to your own pattern to replace it.
# FRONTEND_ORIGIN_REGEX=https://.*\.vercel\.app

# --- Investor access passcode ---------------------------------------------
# Leave unset/empty for no gate at all (open API, matches today's local-dev
# behavior). Set it to require this exact value — via the
# X-Access-Passcode header, or a `?passcode=` query param on the two PDF
# export links — on every route except `/`, /api/auth/status, and
# /api/auth/verify. Not real auth: one shared secret, no rate limiting.
# ACCESS_PASSCODE=
